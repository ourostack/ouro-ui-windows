<Project Sdk="Microsoft.NET.Sdk">
  <!-- Ouro UI's action runtime for Windows: the one entry point every door goes through, the App Action URI reader,
       the MCP server, and Ouro's composed tree (core's composed.mts, ported). Plain .NET, so its tests run anywhere. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Ouro.Actions</PackageId>
    <Description>Ouro UI's action runtime for Windows apps: input validation, idempotency, audit, confirmation and core's person-only refusal, behind App Actions and an MCP server generated from ouro-ui-core's defineAction; and Ouro's composed tree, validated against an app's catalog.</Description>
    <PackageTags>ouro;mcp;app-actions;agents;winui</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
