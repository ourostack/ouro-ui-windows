<?xml version="1.0" encoding="utf-8"?>
<!--
    The kit's templates. They hold structure only: every colour, size and spacing is set by the control's code from
    core's tokens and spec (OuroPaint.cs, OuroUI.cs), so light, dark, a contrast theme and core's six themes all go
    through one path. Focus rings are WinUI's own (UseSystemFocusVisuals), never removed.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ouro.UI.Windows">

    <Style TargetType="local:OuroButton">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OuroButton">
                    <Grid
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <ProgressRing
                            x:Name="Spinner"
                            Width="20"
                            Height="20"
                            IsActive="False"
                            Visibility="Collapsed"
                            AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:OuroBadge">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OuroBadge">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        MinHeight="{TemplateBinding MinHeight}">
                        <TextBlock
                            x:Name="Words"
                            HighContrastAdjustment="None"
                            Text="{TemplateBinding Text}"
                            Foreground="{TemplateBinding Foreground}"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap"
                            TextTrimming="CharacterEllipsis"
                            AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:OuroCard">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OuroCard">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                        <StackPanel x:Name="Stack" Spacing="16">
                            <Grid x:Name="Header" ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        x:Name="TitleText"
                                        Text="{TemplateBinding Title}"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap"
                            TextTrimming="CharacterEllipsis"
                                        AutomationProperties.HeadingLevel="Level2" />
                                    <TextBlock
                                        x:Name="DescriptionText"
                                        Text="{TemplateBinding Description}"
                                        TextWrapping="Wrap"
                            TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <ContentPresenter
                                    x:Name="ActionPresenter"
                                    Grid.Column="1"
                                    VerticalAlignment="Top"
                                    Content="{TemplateBinding Action}" />
                            </Grid>
                            <ContentPresenter
                                x:Name="BodyPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            <ContentPresenter x:Name="FooterPresenter" Content="{TemplateBinding Footer}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:OuroItem">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OuroItem">
                    <Grid
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        MinHeight="{TemplateBinding MinHeight}"
                        ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border x:Name="MediaTile" CornerRadius="8" VerticalAlignment="Center">
                            <ContentPresenter
                                x:Name="MediaPresenter"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Media}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                x:Name="TitleText"
                                Text="{TemplateBinding Title}"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"
                            TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="DescriptionText"
                                Text="{TemplateBinding Description}"
                                TextWrapping="Wrap"
                            TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ContentPresenter
                            x:Name="ActionsPresenter"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Actions}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- OuroTextField's box: a TextBox with no chrome of its own. Its edge, fill, corner and padding are set by
         OuroTextField's code, and the TextBox itself is the 44 epx Edit UI Automation reads. -->
    <Style x:Key="OuroTextFieldInput" TargetType="TextBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ScrollViewer
                            x:Name="ContentElement"
                            Padding="{TemplateBinding Padding}"
                            Foreground="{TemplateBinding Foreground}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalScrollMode="Auto"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Auto"
                            VerticalScrollBarVisibility="Auto"
                            IsTabStop="False"
                            ZoomMode="Disabled"
                            AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:OuroTextField">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OuroTextField">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="LabelText" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                        <Grid>
                            <TextBox x:Name="Input" Style="{StaticResource OuroTextFieldInput}" />
                            <TextBlock
                                x:Name="PlaceholderText"
                                IsHitTestVisible="False"
                                TextTrimming="CharacterEllipsis"
                                AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:OuroCheckbox">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OuroCheckbox">
                    <Grid Background="Transparent" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" VerticalAlignment="Center">
                            <Grid>
                                <Path
                                    x:Name="Tick"
                                    Data="M 3.5,8.5 L 6.75,11.75 L 12.5,5"
                                    StrokeThickness="2"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round" />
                                <Rectangle
                                    x:Name="Dash"
                                    Width="9"
                                    Height="2"
                                    RadiusX="1"
                                    RadiusY="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="LabelText" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:OuroSeparator">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OuroSeparator">
                    <Grid x:Name="Root">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle x:Name="LineStart" />
                        <TextBlock x:Name="LabelText" Grid.Column="1" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                        <Rectangle x:Name="LineEnd" Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:OuroDescriptionList">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OuroDescriptionList">
                    <StackPanel x:Name="Rows" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
