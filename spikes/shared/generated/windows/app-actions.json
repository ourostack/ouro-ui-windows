{
  "version": 3,
  "actions": [
    {
      "id": "Ouro.AddShoppingListItem",
      "description": "Add an item to your shopping list.",
      "displaysUI": true,
      "usesGenerativeAI": false,
      "isAvailable": true,
      "allowedAppInvokers": [
        "*"
      ],
      "inputs": [
        {
          "name": "name",
          "kind": "Text"
        }
      ],
      "inputCombinations": [
        {
          "inputs": [
            "name"
          ],
          "description": "Add to list: ${name.Text}"
        }
      ],
      "invocation": {
        "type": "uri",
        "uri": "ouro-shop-spike://action/add_shopping_list_item?name=${name.Text}&token=${$.Token}"
      }
    }
  ]
}
