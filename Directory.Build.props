<Project>
  <!-- Shared by every project: the kit's version (RELEASING.md), and strict nullable C#. -->
  <PropertyGroup>
    <Version>0.12.1</Version>
    <Authors>Ouro</Authors>
    <Company>Ouro</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ourostack/ouro-ui-windows</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ourostack/ouro-ui-windows</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
