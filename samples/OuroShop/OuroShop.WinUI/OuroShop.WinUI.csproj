<Project Sdk="Microsoft.NET.Sdk">
  <!-- Ouro Shop: the kit's sample and gallery. A shopping list whose buttons people press and agents call, and every
       Button and Badge tone and variant, so CI can screenshot and check each in light, dark and a contrast theme. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>OuroShop</RootNamespace>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Unpackaged, the app still needs its resources.pri: without it WinUI can't find the kit's Themes/Generic.xaml and
         every Ouro control draws nothing, with no error. This makes the build write it (and merge the kit's into it). -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Ouro.UI.Windows\Ouro.UI.Windows.csproj" />
    <Compile Include="..\Generated\OuroActions.g.cs" Link="Generated\OuroActions.g.cs" />
    <Compile Include="..\Shared\ShoppingHandler.cs" Link="Shared\ShoppingHandler.cs" />
    <!-- The composed page's catalog, the card the agent composed and its two updates (shopping.composed.mts writes them). -->
    <EmbeddedResource Include="..\Composed\catalog.json" LogicalName="OuroShop.Composed.catalog.json" />
    <EmbeddedResource Include="..\Composed\card.json" LogicalName="OuroShop.Composed.card.json" />
    <EmbeddedResource Include="..\Composed\update.json" LogicalName="OuroShop.Composed.update.json" />
    <EmbeddedResource Include="..\Composed\update-missing.json" LogicalName="OuroShop.Composed.update-missing.json" />
  </ItemGroup>
</Project>
