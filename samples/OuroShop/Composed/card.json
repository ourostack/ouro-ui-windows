                  {
                    "id": "order",
                    "component": "ActionButton",
                    "props": {
                      "emphasis": "secondary",
                      "action": "place_grocery_order",
                      "label": "Place order",
                      "consent": "person-only",
                      "press": "handoff",
                      "input": {},
                      "handoff": "with Place order on the shopping list"
                    },
                    "children": []
                  }
                ]
              }
            ]
