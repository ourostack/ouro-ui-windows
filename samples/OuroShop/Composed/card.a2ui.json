                "input": {
                  "name": {
                    "@path": "/item"
                  },
                  "quantity": {
                    "@path": "/quantity"
                  }
                },
                "emphasis": "primary"
              },
              {
                "id": "share",
                "component": "ActionButton",
                "action": "share_shopping_list",
                "input": {
                  "with": {
                    "@path": "/share/with"
                  }
                },
                "emphasis": "secondary"
              },
              {
                "id": "order",
                "component": "ActionButton",
                "action": "place_grocery_order",
                "input": {},
                "emphasis": "secondary"
              }
            ]
          }
        }
      ]
    }
