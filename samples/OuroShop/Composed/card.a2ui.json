                "label": "Item",
                "value": {
                  "@path": "/item"
                },
                "hint": "As you'd say it, such as oat milk.",
                "type": "text",
                "multiline": false
              },
              {
                "id": "quantity",
                "component": "TextField",
                "label": "Quantity",
                "value": {
                  "@path": "/quantity"
                },
                "type": "number",
                "multiline": false
              },
              {
                "id": "organic",
                "component": "Checkbox",
                "label": "Only organic",
                "value": {
                  "@path": "/organic"
                }
              },
              {
                "id": "store",
                "component": "Select",
                "label": "Store",
                "value": {
                  "@path": "/store"
                },
                "options": [
                  "Corner Grocer",
                  "Market Hall",
                  "Any"
                ]
              },
              {
                "id": "share_with",
                "component": "TextField",
