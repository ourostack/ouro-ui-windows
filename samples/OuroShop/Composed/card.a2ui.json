                "tone": "warning"
              },
              {
                "id": "plan",
                "component": "Card",
                "children": [
                  "add",
                  "item",
                  "quantity",
                  "organic",
                  "store",
                  "share_with",
                  "actions"
                ]
              },
              {
                "id": "add",
                "component": "Heading",
