                "gap": "large",
                "children": [
                  "week",
                  "items",
                  "plan"
                ]
              },
              {
                "id": "week",
                "component": "Card",
                "children": [
                  "photo",
                  "title",
                  "tags",
                  "why",
                  "details"
                ]
              },
              {
                "id": "photo",
                "component": "Image",
                "url": "https://raw.githubusercontent.com/ourostack/.github/main/brand/og/ouro-ui-windows.jpg",
                "description": "Ouro basking on a cabin windowsill while a small robot opens one pane",
                "aspect": "wide"
              },
              {
                "id": "title",
                "component": "Heading",
                "text": "This week's list",
                "level": 1
              },
              {
                "id": "tags",
                "component": "Stack",
                "direction": "horizontal",
                "gap": "small",
                "children": [
                  "count",
                  "vegan"
                ]
              },
              {
                "id": "count",
                "component": "Badge",
                "text": "3 items",
                "tone": "neutral"
              },
              {
                "id": "vegan",
