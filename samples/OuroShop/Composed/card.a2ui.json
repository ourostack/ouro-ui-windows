                "text": "Vegan",
                "tone": "success"
              },
              {
                "id": "why",
                "component": "Text",
                "text": "Picked from the recipes you cooked this month.",
                "tone": "muted"
              },
              {
                "id": "details",
                "component": "DescriptionList",
                "items": [
                  {
                    "term": "Delivery",
                    "detail": "Saturday"
                  },
                  {
                    "term": "Store",
                    "detail": "Corner Grocer"
                  }
                ]
              },
              {
                "id": "items",
                "component": "Card",
                "children": [
                  "pick",
                  "things",
                  "line",
                  "steps",
                  "low"
