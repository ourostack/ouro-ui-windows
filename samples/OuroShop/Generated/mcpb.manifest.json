{
  "manifest_version": "0.1",
  "name": "OuroShop.Mcp",
  "version": "0.1.0",
  "description": "Ouro UI actions for shopping, generated from their declarations.",
  "author": {
    "name": "Ouro"
  },
  "server": {
    "type": "binary",
    "entry_point": "OuroShop.Mcp.exe",
    "mcp_config": {
      "command": "OuroShop.Mcp.exe",
      "args": []
    }
  },
  "tools": [
    {
      "name": "add_shopping_list_item",
      "description": "Add one item to the person's shopping list. Give the name as the person said it; leave quantity out when they gave none."
    },
    {
      "name": "share_shopping_list",
      "description": "Share the person's shopping list with another person, who can then see and change it. The person confirms first."
    }
  ],
  "tools_generated": false,
  "license": "MIT",
  "_meta": {
    "com.microsoft.windows": {
      "static_responses": {
        "initialize": {
          "protocolVersion": "2025-06-18",
          "capabilities": {
            "tools": {
              "listChanged": false
            }
          },
          "serverInfo": {
            "name": "OuroShop.Mcp",
            "version": "0.1.0"
          }
        },
        "tools/list": {
          "tools": [
            {
              "name": "add_shopping_list_item",
              "title": "Add to list",
              "description": "Add one item to the person's shopping list. Give the name as the person said it; leave quantity out when they gave none.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "What to buy, as the person said it, such as \"oat milk\".",
                    "maxLength": 80
                  },
                  "quantity": {
                    "type": "number",
                    "description": "How many or how much.",
                    "minimum": 0
                  },
                  "idempotencyKey": {
                    "type": "string",
                    "description": "Send the same key again when retrying this exact call, and the item is added once."
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              },
              "annotations": {
                "readOnlyHint": false,
                "destructiveHint": false,
                "openWorldHint": false
              },
              "outputSchema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The new item's id."
                  }
                },
                "required": [
                  "id"
                ],
                "additionalProperties": false
              }
            },
            {
              "name": "share_shopping_list",
              "title": "Share list",
              "description": "Share the person's shopping list with another person, who can then see and change it. The person confirms first.",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "with": {
                    "type": "string",
                    "description": "The email address of the person to share with.",
                    "format": "email"
                  }
                },
                "required": [
                  "with"
                ],
                "additionalProperties": false
              },
              "annotations": {
                "readOnlyHint": false,
                "destructiveHint": true,
                "openWorldHint": true
              },
              "_meta": {
                "ouro.bot/confirm": "Share your shopping list with someone in your household."
              }
            }
          ]
        }
      }
    }
  }
}
